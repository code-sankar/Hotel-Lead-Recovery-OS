# =============================================================================
# Lead Stay — environment
# Copy to .env.local for local development. Never commit real credentials.
# =============================================================================

# --- Supabase (required) -----------------------------------------------------
# Project URL and anon key from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key. Server-only: used by the webhook, the worker and demo
# simulation. It bypasses RLS, so it must never be exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set to false to hide demo-mode simulation tooling (e.g. in production).
DEMO_MODE_ENABLED=true
# Shared secret for the follow-up cron endpoint (/api/cron/follow-ups).
CRON_SECRET=

# --- OpenAI (optional) -------------------------------------------------------
# Without a key the app falls back to a deterministic rule-based reply engine
# and labels every message it produces as `rules-v1` instead of a model name.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- WhatsApp Cloud API (optional; per-hotel values can also be stored in the
# --- app under Settings → WhatsApp. These act as the fallback/default.) -------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# --- Redis / BullMQ (optional) ----------------------------------------------
# Without REDIS_URL, background jobs run inline in the same process. That is
# fine for local development but not for production.
REDIS_URL=
